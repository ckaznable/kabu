FROM docker.io/library/rust:1.94-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY shared/ shared/
COPY server/ server/
COPY updater/ updater/
COPY typegen/ typegen/
COPY migrations/ migrations/

RUN cargo build --release -p kabu-updater

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*

WORKDIR /data
COPY --from=builder /app/target/release/kabu-updater /usr/local/bin/kabu-updater
COPY migrations/ /data/migrations/

ENTRYPOINT ["/usr/local/bin/kabu-updater"]
